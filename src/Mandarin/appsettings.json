{
  "AllowedHosts": "*",
  "Auth0": {
    "Domain": "bashi.eu.auth0.com",
    "ClientId": "",
    "ClientSecret": "",
    "Audience": ""
  },
  "ConnectionStrings": {
    "MandarinConnection": "Host=localhost;Database=postgres;Username=postgres;Password=password;Maximum Pool Size=20"
  },
  "Hangfire": {
    "ConfigureRecurringJobs": true
  },
  "Mandarin": {
    "FixedCommissionAmountFilePath": ""
  },
  "SendGrid": {
    "ApiKey": "<INVALID KEY>",
    "ServiceEmail": null,
    "RealContactEmail": null,
    "RecordOfSalesTemplateId": null
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Elastic.Apm": "Error",
        "Hangfire": "Information",
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient.sendgrid": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss.ffff} {Level:u3} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Square": {
    "ApiKey": "<INVALID KEY>",
    "Environment": "Production",
    "Host": "https://connect.squareup.com"
  }
}
